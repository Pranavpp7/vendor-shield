# Copy to `.env` in the repo root (gitignored) before:
#   docker compose --profile full up -d --build
# See docs/DEPLOY.md — there is no no-card public host that can run this
# image. This file is for local Docker, not a PaaS.

# Groq free demo scorer. llama-3.3-70b-versatile 404s.
# Injection filter in services/evaluation.py; 2026-10-29 gate: 48/50,
# 0 false-PASS. LLM_CONCURRENCY=1 (Groq free 8k TPM).
OPENROUTER_API_KEY=gsk_replace_me
OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
LLM_CONCURRENCY=1
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Eval-verified alternative (~$0.006 per 21-control run):
# OPENROUTER_API_KEY=sk-or-replace_me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_CONCURRENCY=4
# LLM_PRICE_IN_PER_M=0.12
# LLM_PRICE_OUT_PER_M=0.30

# Optional shared secret if you expose the machine. Leave empty on localhost.
API_KEY=

AUTO_SEED=1
DEMO_MODE=0
CORS_ALLOW_ORIGINS=*
SITE_ADDRESS=:80
